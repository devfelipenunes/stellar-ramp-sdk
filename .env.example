# Copie para .env — nunca commitar (já está no .gitignore). Usado por
# `pnpm example:live` (tsx --env-file=.env). Passo a passo completo: tutorial.md.

ETHERFUSE_API_KEY=
ETHERFUSE_BASE_URL=https://api.sand.etherfuse.com
ETHERFUSE_CUSTOMER_ID=
HORIZON_URL=https://horizon-testnet.stellar.org
YIELD_WALLET_SECRET=

# Opcional — só necessário se você rodar seu PRÓPRIO webhook receiver
# (examples/etherfuse-webhook-server.ts) em vez de reaproveitar um já deployado.
# Gere um valor novo via POST /ramp/webhook — nunca reaproveite um secret antigo copiado.
ETHERFUSE_WEBHOOK_SECRET=

# Ramp real (tutorial.md seção 3) — usados por scripts/confirm-sandbox.mjs e
# confirm-followup.mjs. Gere PRIVATE_KEY_PATH/KID na seção 3.2; ISS só existe depois de
# registrar sua chave na Etherfuse (seção 3.4) — sem ele, /idv é rejeitado (invalid_client).
ETHERFUSE_ISS=
ETHERFUSE_PRIVATE_KEY_PATH=secrets/etherfuse/jwtRS256.key
ETHERFUSE_KID=

# Opcional — persona de teste usada por confirm-sandbox.mjs/confirm-followup.mjs
# (sandbox aceita qualquer identidade fake). Sem preencher, cai no default
# "Maria Silva" com CPF sintético (52998224725 — passa o dígito verificador,
# não é de ninguém real). Só mude se quiser rodar com outra identidade de teste.
EF_EMAIL=
CPF=
