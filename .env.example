# Copie para .env — nunca commitar (já está no .gitignore). Usado por
# `pnpm flow` (tsx --env-file=.env examples/pix-tesouro-brl.ts).
# Passo a passo completo: Workflow-Manual-teste.md.

ETHERFUSE_API_KEY=
ETHERFUSE_BASE_URL=https://api.sand.etherfuse.com

# customerId "raiz" da sua conta sandbox (o mesmo que POST /ramp/wallet sempre usa —
# em sandbox já vem com KYC aprovado). Confirme com:
#   curl -s "$ETHERFUSE_BASE_URL/ramp" -H "Authorization: $ETHERFUSE_API_KEY"
ETHERFUSE_CUSTOMER_ID=

HORIZON_URL=https://horizon-testnet.stellar.org

# Embedded wallet (gerada 1x — pnpm flow cria sozinha se estas 3 estiverem vazias e
# imprime os valores pra você colar aqui).
ETHERFUSE_WALLET_ID=
ETHERFUSE_WALLET_PUBLIC_KEY=
ETHERFUSE_SIGNER_PRIVATE_KEY_PATH=secrets/etherfuse/embedded-wallet-signer.pem

# Conta PIX do customer raiz (criada 1x — pnpm flow cria sozinha se vazio e imprime
# o valor pra você colar aqui).
ETHERFUSE_BANK_ACCOUNT_ID=

# Opcional — persona da conta PIX (sandbox aceita qualquer identidade fake).
# Sem preencher, usa "Maria Silva" com CPF sintético (52998224725 — passa o dígito
# verificador, não é de ninguém real).
EF_EMAIL=
CPF=
