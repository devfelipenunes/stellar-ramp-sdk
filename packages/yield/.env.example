# Copie para .env — nunca commitar (.env já está no .gitignore da raiz deste repo).
# Rodar scripts/testes com: node --env-file=.env <script>  (Node >=20.6; o repo já exige
# Node 22 por causa de node:sqlite, então a flag está sempre disponível).
#
# Como obter/preencher cada variável: docs/plan-etherfuse-stablebond-real.md, seção 10.

# Mesma chave usada pelo EtherfuseProvider da Track Ramp (packages/sdk) — a Etherfuse trata
# ambas as tracks como o mesmo customer se o customerId for reaproveitado (ver seção 8 do
# plano). Sandbox: criar conta em sandbox.etherfuse.com, org business, "Approve KYB", gerar
# chave em Manage Accounts.
ETHERFUSE_API_KEY=
ETHERFUSE_BASE_URL=https://api.sand.etherfuse.com
ETHERFUSE_ENVIRONMENT=sandbox

# organizationId/customerId já onboarded (org criada + KYC aprovado via WebSDK /idv — ver
# docs/production.md). Este plano não inclui onboarding do zero para o Yield sozinho.
ETHERFUSE_CUSTOMER_ID=

# Secret devolvido 1x por POST /ramp/webhook ao registrar a URL pública do handler de
# swap_updated (EtherfuseStablebondProvider.confirmSwapWebhook). Guardar com segurança, só
# aparece uma vez na resposta.
ETHERFUSE_WEBHOOK_SECRET=

HORIZON_URL=https://horizon-testnet.stellar.org

# Wallet que assina a sendTransaction recebida no webhook (KeypairStellarSigner). Testnet
# apenas — nunca uma chave com fundos reais. Gerar com:
#   node -e "const {Keypair}=require('@stellar/stellar-base'); const k=Keypair.random(); console.log(k.publicKey(), k.secret())"
YIELD_WALLET_SECRET=
