{
  "name": "stellar-ramp-sdk",
  "version": "0.2.0",
  "private": true,
  "description": "SDK de rampa fiat regional (PIX/SPEI) ↔ Stablebond (Etherfuse) na Stellar, via embedded wallet",
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "test:tdd": "vitest run packages/sdk/tests",
    "typecheck": "tsc -p packages/sdk/tsconfig.json --noEmit && tsc -p packages/sdk/tsconfig.test.json",
    "build": "tsc -b",
    "build:publish": "tsup",
    "flow": "tsx --env-file=.env examples/pix-tesouro-brl.ts"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@vitest/coverage-v8": "^2.1.9",
    "tsup": "^8.5.1",
    "tsx": "^4.19.0",
    "typescript": "^5.5.0",
    "vitest": "^2.1.0"
  }
}
